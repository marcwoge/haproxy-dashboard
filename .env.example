# ============================================================
#  Central configuration for the Acme Platform
#  Copy this file to .env and adjust the values:
#      cp .env.example .env
# ============================================================

# Domain HAProxy responds to (freely configurable)
PLATFORM_DOMAIN=platform.example.local

# Default UI language (fallback). The active language is stored per-install in
# services.yaml (key "language") and switchable in the admin GUI. Shipped: de, en.
# Add more by dropping a file into config-app/lang/<code>.json.
PLATFORM_LANG=de

# Admin GUI access protection (Basic auth).
# IMPORTANT: ADMIN_PASSWORD MUST be set. Empty = the admin GUI is LOCKED
# (not open!). Generate a strong password e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_USER=admin
ADMIN_PASSWORD=

# Brute-force protection on the admin login (H2): after LOGIN_MAX_ATTEMPTS wrong
# attempts within LOGIN_WINDOW seconds the client IP is locked for
# LOGIN_LOCKOUT seconds (HTTP 429).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW=300
LOGIN_LOCKOUT=300

# Time zone
TZ=Europe/Berlin

# Stable Compose project name (also required by the updater!)
COMPOSE_PROJECT_NAME=acme-platform

# ---------------- Update channel ----------------
# Repo (owner/name) for the update check and GHCR images
UPDATE_REPO=your-org/haproxy-dashboard

# Which image version to run: "latest" or a fixed tag like "v1.0.0".
# The host-side updater writes the new version here after a successful update.
IMAGE_TAG=latest

# Locally built version stamp (when running GHCR images the version is baked in)
APP_VERSION=1.0.0

# Update execution:
#   manual     = the GUI only shows the command (no automation, no socket)
#   host-agent = the GUI writes a request; the host-side updater (systemd)
#                runs verify -> pull -> healthcheck -> rollback
UPDATE_MODE=manual

# RBAC: a separate, higher role for system.update (two-step confirmation in the GUI).
# Leave empty = update actions require (at least) the normal admin.
PLATFORM_ADMIN_USER=
PLATFORM_ADMIN_PASSWORD=

# Platform Connector API (opt-in): machine token that lets connector sidecars in
# other compose projects self-register their service (tile + route) via /api/v1/*.
# Empty = the API is disabled (404). Separate from the admin password; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECTOR_TOKEN=

# Remove orphaned connector routes after this many seconds without a heartbeat
# (0 = off). Must be larger than the connector's HEARTBEAT (default 60).
CONNECTOR_TTL=180

# GitHub access - ONLY needed for PRIVATE repos/GHCR packages.
# For a PUBLIC repo + PUBLIC GHCR packages leave both EMPTY:
#   - the release check then runs anonymously (60 requests/h per IP is plenty)
#   - `docker compose pull` pulls public images without `docker login`
# For private packages: a read-only token (this repo/package only) + GHCR user,
# ideally a dedicated machine account. See the README, section 7.
UPDATE_TOKEN=
GHCR_USER=

# HSTS (N2): forces HTTPS in the browser. Enable ONLY with a REAL certificate -
# with the self-signed fallback it would lock out access permanently!
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000

# ---------------- real client IP behind a proxy/tunnel (#23) ----------------
# Behind a reverse proxy or tunnel (e.g. Cloudflare Tunnel -> HAProxy) HAProxy
# would otherwise see the proxy's IP as the source, so the login lockout and the
# logs use that single IP. Set REAL_IP_HEADER to the header carrying the real
# client IP and TRUSTED_PROXIES to the CIDR(s) the proxy connects from. The IP is
# only taken from the header when the connection originates from a trusted CIDR
# (otherwise it would be spoofable). Both empty = feature off.
#   Cloudflare Tunnel example:
#     REAL_IP_HEADER=CF-Connecting-IP
#     TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 ...   (or your tunnel subnet)
REAL_IP_HEADER=
TRUSTED_PROXIES=

# #24: frontend mode.
#   https (default) = HAProxy terminates TLS on :443, :80 redirects to :443.
#   http            = TLS terminates UPSTREAM (e.g. a Cloudflare Tunnel); HAProxy
#                     routes plain HTTP directly on :80, no HTTPS redirect, no :443.
#                     Publish :80 to the tunnel and usually set REAL_IP_HEADER above.
FRONTEND_MODE=https

# ---------------- logging & health-check secrets ----------------
# E6: optional syslog target for HAProxy. Empty = file logging only (default).
# Examples: "10.0.0.5:514" (remote) or "/dev/log" (local socket). The value is
# rendered into the generated HAProxy config as a `log ... local0` line.
SYSLOG_ADDRESS=

# E6: retention of the in-container HAProxy log file. When it grows past
# LOG_ROTATE_AT lines it is truncated to the last LOG_KEEP_LINES lines. Raise
# both for a longer local history (syslog above is the better long-term sink).
LOG_ROTATE_AT=5000
LOG_KEEP_LINES=600

# E4: directory (inside the config-app container) holding health-check header
# secret files. Each file contains only the raw header value; reference it per
# service in the admin GUI. Default lives under the mounted config volume, i.e.
# host path ./data/config/secrets/. Change only if you mount secrets elsewhere.
HC_SECRET_DIR=/app/config/secrets

# ---------------- internal certificate authority (opt-in) ----------------
# Only used when you start the CA profile:  docker compose --profile ca up -d
# step-ca then issues short-lived certs to your backends (ACME) and HAProxy
# verifies them against the internal root. See ca/README.md. Leave the profile
# off and these values are irrelevant.
#
# Password that encrypts the CA private keys. MUST be set before the FIRST start
# of the ca profile (it initializes the CA). Generate e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
STEPCA_PASSWORD=
# Display name and the DNS names/SANs the CA server certificate is valid for
# (how backends address the CA; add a routable name for multi-host setups).
CA_NAME=Acme Internal CA
CA_DNS_NAMES=step-ca,localhost

# ---------------- host-side updater (systemd) ----------------
# Signature verification of the images (cosign). Strongly recommended: true.
VERIFY_SIGNATURES=true

# Auto-update schedule (systemd timer acme-update-check.timer).
#   AUTO_UPDATE=true  -> on a new, SIGNED release the timer automatically
#                        requests an update (with healthcheck/rollback).
#   AUTO_UPDATE_SCHEDULE is only a display text in the admin GUI; the real
#   schedule lives in the .timer unit (OnCalendar, default daily 03:30).
AUTO_UPDATE=false
AUTO_UPDATE_SCHEDULE=daily 03:30
