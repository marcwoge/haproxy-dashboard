# ============================================================
#  Zentrale Konfiguration der Acme Platform
#  Kopiere diese Datei nach .env und passe die Werte an:
#      cp .env.example .env
# ============================================================

# Domain, auf die der HAProxy reagiert (frei konfigurierbar)
PLATFORM_DOMAIN=platform.example.local

# Admin-GUI Zugangsschutz (Basic-Auth).
# WICHTIG: ADMIN_PASSWORD MUSS gesetzt werden. Leer = Admin-GUI ist GESPERRT
# (nicht offen!). Ein starkes Passwort z. B. erzeugen mit:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_USER=admin
ADMIN_PASSWORD=

# Zeitzone
TZ=Europe/Berlin

# Stabiler Compose-Projektname (wird auch vom Updater benoetigt!)
COMPOSE_PROJECT_NAME=acme-platform

# ---------------- Update-Kanal ----------------
# Repo (owner/name) fuer Update-Pruefung und GHCR-Images
UPDATE_REPO=your-org/haproxy-dashboard

# Welche Image-Version laufen soll: "latest" oder ein fixes Tag wie "v1.0.0".
# Der host-seitige Updater schreibt hier nach erfolgreichem Update die neue Version.
IMAGE_TAG=latest

# Lokal gebauter Versionsstempel (bei GHCR-Betrieb steckt die Version im Image)
APP_VERSION=1.0.0

# Update-Ausfuehrung:
#   manual     = GUI zeigt nur den Befehl an (kein Automatismus, kein Socket)
#   host-agent = GUI schreibt eine Anforderung; der host-seitige Updater (systemd)
#                fuehrt verify -> pull -> healthcheck -> rollback aus
UPDATE_MODE=manual

# RBAC: getrennte, hoehere Rolle fuer system.update (Zwei-Schritt-Bestaetigung im GUI).
# Leer lassen = Update-Aktionen erfordern (mindestens) den normalen Admin.
PLATFORM_ADMIN_USER=
PLATFORM_ADMIN_PASSWORD=

# GitHub-Zugang - NUR fuer PRIVATE Repos/GHCR-Pakete noetig.
# Bei OEFFENTLICHEM Repo + OEFFENTLICHEN GHCR-Paketen beides LEER lassen:
#   - Release-Pruefung laeuft dann anonym (60 Anfragen/h pro IP genuegen locker)
#   - `docker compose pull` laedt oeffentliche Images ohne `docker login`
# Fuer private Pakete: read-only Token (nur dieses Repo/Package) + GHCR-Benutzer,
# idealerweise ein dediziertes Maschinen-Konto. Siehe README, Abschnitt 7.
UPDATE_TOKEN=
GHCR_USER=

# ---------------- host-seitiger Updater (systemd) ----------------
# Signaturpruefung der Images (cosign). Dringend empfohlen: true.
VERIFY_SIGNATURES=true

# Auto-Update-Zeitplan (systemd-Timer acme-update-check.timer).
#   AUTO_UPDATE=true  -> der Timer fordert bei neuem, SIGNIERTEM Release
#                        automatisch ein Update an (mit Healthcheck/Rollback).
#   AUTO_UPDATE_SCHEDULE ist nur ein Anzeigetext im Admin-GUI; der echte
#   Zeitplan steht in der .timer-Unit (OnCalendar, Standard taeglich 03:30).
AUTO_UPDATE=false
AUTO_UPDATE_SCHEDULE=täglich 03:30
