[Unit]
Description=Acme auto-update: regelmaessige Release-Pruefung

[Timer]
# Standard: taeglich 03:30 (Ortszeit) mit etwas Streuung. Anpassbar per
# `sudo systemctl edit acme-update-check.timer` (OnCalendar ueberschreiben).
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
